# ── Frontend Environment — LOCAL DEVELOPMENT ─────────────────────────────────
# Used by: vite dev server (npm run dev)
# The frontend's config.js already auto-detects hostname for localhost,
# so setting this is optional for local dev. Set it if you use a different port.
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
