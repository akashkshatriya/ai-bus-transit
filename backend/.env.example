# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# REQUIRED: must be set before starting the server
SECRET_KEY=change_this_to_a_secure_secret_key_at_least_32_chars

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default, fine for demo/single-instance)
DATABASE_URL=sqlite:///./bus_tracker.db
# PostgreSQL (for production multi-user scaling):
# DATABASE_URL=postgresql://user:password@host:5432/bus_tracker

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# LOCAL:
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,http://localhost
# PRODUCTION (replace with your actual Vercel URL):
# CORS_ORIGINS=https://your-app.vercel.app,capacitor://localhost
